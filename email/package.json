{
  "name": "@keelsonhq/email",
  "version": "0.1.0",
  "description": "Keelson Email SDK for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "keelson",
    "email",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keelsonhq/node-sdk.git",
    "directory": "email"
  },
  "homepage": "https://keelson.dev",
  "bugs": "https://github.com/keelsonhq/node-sdk/issues",
  "author": "Keelson",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}

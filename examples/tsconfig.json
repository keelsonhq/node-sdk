{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@keelsonhq/email": ["email/src/index.ts"],
      "@keelsonhq/identity": ["identity/src/index.ts"],
      "@keelsonhq/media": ["media/src/index.ts"]
    }
  },
  "include": ["*.ts"]
}
